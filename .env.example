# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Custom Auth Domain (Optional)
# To replace 'webos-ff50c.firebaseapp.com' with 'webos-green.vercel.app' (or your custom domain)
# in the Google OAuth sign-in account chooser, set this environment variable in your Vercel project:
# VITE_FIREBASE_AUTH_DOMAIN="webos-green.vercel.app"
VITE_FIREBASE_AUTH_DOMAIN=""
